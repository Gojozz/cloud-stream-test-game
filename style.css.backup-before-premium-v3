* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 720px;
    height: 1280px;
    overflow: hidden;
    background: #03050a;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background:
        radial-gradient(circle at 50% 10%, #17294f 0%, #080b14 38%, #020307 100%);
}

/* HEADER */

.header {
    height: 145px;
    text-align: center;
    padding-top: 20px;
}

.live {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 20px;
    background: #ff1744;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 2px;
    box-shadow: 0 0 20px rgba(255,23,68,.6);
}

.title {
    margin-top: 8px;
    font-size: 52px;
    line-height: 1;
    font-weight: 900;
    color: #ffd166;
    text-shadow: 0 0 25px rgba(255,180,0,.55);
}

.subtitle {
    margin-top: 8px;
    color: #67e8f9;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 3px;
}

/* MAIN */

.main {
    height: 825px;
    display: flex;
    gap: 14px;
    padding: 0 18px;
}

/* LEADERBOARD */

.leaderboard {
    width: 170px;
    flex-shrink: 0;
    padding: 15px 10px;
    border-radius: 22px;
    border: 2px solid rgba(255,255,255,.14);
    background: rgba(7,11,22,.94);
}

.lb-title {
    text-align: center;
    margin-bottom: 12px;
    color: #ffd166;
    font-size: 18px;
    font-weight: 900;
}

.player {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    margin-bottom: 8px;
    padding: 8px;
    border-radius: 12px;
    background: rgba(255,255,255,.06);
    font-size: 13px;
    font-weight: 900;
    overflow: hidden;
}

.player-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dot {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid white;
}

.red { background:#ff1744; }
.cyan { background:#00e5ff; }
.yellow { background:#ffd166; }
.green { background:#2ecc71; }
.purple { background:#b86bff; }

/* TRACK */

.track {
    position: relative;
    flex: 1;
    height: 100%;
    overflow: hidden;
    border: 5px solid #ffd166;
    border-radius: 30px;
    background:
        repeating-linear-gradient(
            90deg,
            rgba(255,255,255,.025) 0,
            rgba(255,255,255,.025) 30px,
            transparent 30px,
            transparent 60px
        ),
        linear-gradient(#111827,#05070d);
    box-shadow:
        inset 0 0 45px rgba(0,0,0,.9),
        0 0 25px rgba(255,209,102,.15);
}

.start-line {
    position: absolute;
    top: 18px;
    left: 0;
    right: 0;
    height: 5px;
    background: #00e5ff;
    box-shadow: 0 0 15px #00e5ff;
}

.finish {
    position: absolute;
    bottom: 25px;
    left: 0;
    right: 0;
    height: 44px;

    background:
        conic-gradient(
            #fff 25%,
            #111 0 50%,
            #fff 0 75%,
            #111 0
        ) 0 0 / 44px 44px;

    border-top: 4px solid #ff1744;
    border-bottom: 4px solid #ff1744;
}

.finish-label {
    position: absolute;
    bottom: 78px;
    width: 100%;
    text-align: center;
    color: #ff526d;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 4px;
}


/* TOP-DOWN RACING CARS */

.track {
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(circle at 20% 20%, rgba(255,255,255,.08), transparent 28%),
        linear-gradient(135deg,#23833f 0%,#17652f 50%,#0f5127 100%);
}

.circuit-svg {
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    z-index:1;
    pointer-events:none;
}

.circuit-road {
    fill:none;
    stroke:rgba(20,20,20,.72);
    stroke-width:104;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.circuit-center {
    fill:none;
    stroke:rgba(255,255,255,.62);
    stroke-width:3;
    stroke-dasharray:18 15;
    stroke-linecap:round;
}

.circuit-finish {
    fill:none;
    stroke:white;
    stroke-width:12;
    stroke-dasharray:8 8;
}

.marble {
    position:absolute;
    width:48px;
    height:34px;
    border-radius:14px 14px 10px 10px;
    z-index:8;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding-top:7px;
    box-sizing:border-box;
    color:white;
    font-size:8px;
    font-weight:900;
    letter-spacing:.4px;
    text-shadow:0 1px 2px #000;
    border:2px solid rgba(255,255,255,.9);
    box-shadow:
        0 5px 8px rgba(0,0,0,.45),
        inset 0 3px 4px rgba(255,255,255,.45),
        inset 0 -5px 6px rgba(0,0,0,.25);
    transition:
        left .12s linear,
        top .12s linear,
        transform .12s linear;
}

.marble::before {
    content:"";
    position:absolute;
    left:9px;
    right:9px;
    top:5px;
    height:15px;
    border-radius:7px 7px 5px 5px;
    background:rgba(30,40,55,.78);
    border:1px solid rgba(255,255,255,.35);
    z-index:-1;
}

.marble::after {
    content:"";
    position:absolute;
    left:4px;
    right:4px;
    bottom:-3px;
    height:6px;
    border-radius:50%;
    background:rgba(0,0,0,.35);
    filter:blur(2px);
    z-index:-2;
}

#track .marble:nth-of-type(2){background:#e53935}
#track .marble:nth-of-type(3){background:#00a9c7}
#track .marble:nth-of-type(4){background:#e4ae00}
#track .marble:nth-of-type(5){background:#27ae60}
#track .marble:nth-of-type(6){background:#8e44ad}

.finish-label{z-index:6}

/* COUNTDOWN */

.countdown {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.countdown span {
    font-size: 110px;
    font-weight: 900;
    color: white;
    text-shadow:
        0 0 20px #00e5ff,
        0 0 60px #00e5ff;
}

/* WINNER */

.winner {
    position: absolute;
    z-index: 30;
    left: 15px;
    right: 15px;
    top: 40%;
    padding: 18px;
    text-align: center;
    border-radius: 18px;
    background: rgba(0,0,0,.88);
    border: 2px solid #ffd166;
    box-shadow: 0 0 40px rgba(255,209,102,.45);

    opacity: 0;
    transform: scale(.8);
    pointer-events: none;
    transition: .3s ease;
}

.winner.show {
    opacity: 1;
    transform: scale(1);
}

.winner-small {
    color: #67e8f9;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 3px;
}

.winner-name {
    margin-top: 5px;
    color: #ffd166;
    font-size: 32px;
    font-weight: 900;
}

/* AI */

.ai {
    height: 210px;
    margin: 15px 18px 0;
    padding: 18px 20px;
    border-radius: 25px;
    background: linear-gradient(
        135deg,
        rgba(116,38,255,.85),
        rgba(0,198,255,.75)
    );
    border: 2px solid rgba(255,255,255,.3);
}

.ai-top {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ai-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: white;
    color: #702cff;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 25px;
}

.ai-name {
    font-size: 22px;
    font-weight: 900;
}

.ai-status {
    margin-top: 2px;
    color: #d8faff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.speech {
    margin-top: 13px;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 800;
}

/* FOOTER */

.footer {
    height: 85px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #aab3c5;
    font-size: 14px;
    font-weight: 800;
}

.round {
    color: #ffd166;
}

/* =========================================================
   NEXT RACERS
========================================================= */

.joiners {
    width: 170px;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 560px;
    padding: 12px 9px;
    border-radius: 18px;
    border: 2px solid rgba(103,232,249,.25);
    background: rgba(7,11,22,.94);
    box-shadow: 0 0 18px rgba(0,229,255,.08);
}

.joiners-title {
    text-align: center;
    margin-bottom: 9px;
    color: #67e8f9;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
}

.joiners-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-height: 24px;
    color: rgba(255,255,255,.65);
    font-size: 11px;
    font-weight: 800;
    overflow: hidden;
}

.joiner {
    display: block;
    padding: 5px 6px;
    border-radius: 8px;
    background: rgba(255,255,255,.055);
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* =========================================================
   MARBLE 3D CAMERA
   Lightweight CSS perspective for live streaming.
========================================================= */
.track {
    --camera-y: 0px;
    perspective: 900px;
    perspective-origin: 50% 45%;
    overflow: hidden;
    transform-style: preserve-3d;
    background:
        linear-gradient(90deg,
            rgba(0,0,0,.22),
            transparent 18%,
            transparent 82%,
            rgba(0,0,0,.22)),
        repeating-linear-gradient(
            90deg,
            rgba(255,255,255,.018) 0,
            rgba(255,255,255,.018) 2px,
            transparent 2px,
            transparent 48px),
        linear-gradient(180deg, #101a2b 0%, #08101d 100%);
}

.track::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: .9;
    background:
        linear-gradient(90deg,
            transparent 0%,
            rgba(0,229,255,.06) 22%,
            transparent 50%,
            rgba(255,210,80,.06) 78%,
            transparent 100%);
}

.marble {
    transform:
        translate3d(0, calc(-1 * var(--camera-y)), 0)
        scale(var(--depth-scale, 1));
    transform-origin: center center;
    will-change: transform, top;
    z-index: 8;
    transition:
        top .10s linear,
        left .2s linear,
        transform .16s ease-out;
}

.finish,
.finish-label,
.start-line {
    transform:
        translate3d(0, calc(-1 * var(--camera-y)), 0);
    will-change: transform;
    transition: transform .16s ease-out;
}

.track::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 2;
    opacity: .32;
    background:
        linear-gradient(90deg,
            transparent 0 19%,
            rgba(0,229,255,.18) 19.2%,
            transparent 19.5% 39.5%,
            rgba(255,255,255,.10) 39.7%,
            transparent 40% 60%,
            rgba(255,255,255,.10) 60.3%,
            transparent 60.5% 80.5%,
            rgba(0,229,255,.18) 80.8%,
            transparent 81% 100%);
}

@media (prefers-reduced-motion: reduce) {
    .marble,
    .finish,
    .finish-label,
    .start-line {
        transition: none;
    }
}

